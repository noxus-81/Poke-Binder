# Exemple de configuration d'environnement (ne contient AUCUNE vraie clé)
# Renommez ce fichier en ".env" en local et remplissez vos valeurs si nécessaire.

PORT=3000
NODE_ENV=development
JWT_SECRET=remplacez_par_un_secret_aleatoire_en_production

# Optionnels (le site fonctionne 100% sans clé grâce à TCGDex et Tesseract) :
POKEMON_TCG_API_KEY=
GEMINI_API_KEY=
